    ],
    "valueTexts": [
     "Հասարակական գիտություններ",
     "Բնական գիտություններ",
     "Տեխնիկական գիտություններ",
     "Բանասիրական գիտություններ",
     "Արդյունաբերություն",
     "Տրանսպորտ, կապ",
     "Ինֆորմատիկա, համակարգչային տեխնոլոգիաներ",
     "Շինարարություն, ճարտարապետություն",
     "Գյուղատնտեսություն",
     "Անասնապահություն",
     "Բուսաբուծություն",
     "Առողջապահություն, բժշկություն",
     "Ֆիզիկական կուլտուրա և սպորտ",
     "Արվեստ",
     "Մշակութային հուշարձաններ",
     "Մշակույթի ընդհանուր հարցեր",
     "Երաժշտություն, թատրոն, կինո",
     "Կերպարվեստ",
     "Զանգվածային լրատվամիջոցներ, լրագրություն",
     "Կրթություն, մանկավարժություն",
     "Գեղարվեստական գրականություն",
     "Մանկական գրականություն",
     "Ընդհանուր բնույթի հրատարակություններ",
     "Ընդամենը"
    ]
   },
