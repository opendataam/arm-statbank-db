    "valueTexts": [
     "Խնամյալների թվաքանակը տարեսկզբին, ընդամենը",
     "Խնամյալների թվաքանակը տարեսկզբին, կանայք",
     "Դուրս են եկել, ընդամենը",
     "Դուրս են եկել, կանայք",
     "  վերադարձել են հարազատների մոտ, ընդամենը",
     "  վերադարձել են հարազատների մոտ, կանայք",
     "  մահացել են, ընդամենը",
     "  մահացել են, կանայք",
     "  այլ պատճառներով, ընդամենը",
     "  այլ պատճառներով, կանայք",
     "Ընդունվել են, ընդամենը",
     "Ընդունվել են, կանայք",
     "  նրանցից` նախկինում եղել են տարեցների և հաշմանդամների սոցիալական սպասարկման կազմակերպություններում, ընդամենը",
     "  նրանցից` նախկինում եղել են տարեցների և հաշմանդամների սոցիալական սպասարկման կազմակերպություններում, կանայք",
     "Խնամյալների թվաքանակը տարեվերջին, ընդամենը",
     "Խնամյալների թվաքանակը տարեվերջին, կանայք",
     "  անկողնային, ընդամենը",
     "  անկողնային, կանայք",
     "  հաշմանդամներ, ընդամենը",
     "  հաշմանդամներ, կանայք",
     "  զավակներ ունեցողներ, ընդամենը",
     "  զավակներ ունեցողներ, կանայք",
     "  ամուսնական զույգեր"
