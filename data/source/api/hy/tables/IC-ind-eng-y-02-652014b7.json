    "valueTexts": [
     "1. Արտադրվել է էլեկտրաէներգիա, ընդամենը",
     "1.1. ջերմային էլեկտրակայաններում",
     "1.2.հիդրոէլեկտրակայաններում",
     "1.3. ատոմային էլեկտրակայաններում",
     "1.4. հողմային էլեկտրակայաններում",
     "1.5. արևային էլեկտրակայաններում",
     "2. Ներմուծվել է էլեկտրաէներգիա",
     "3. Արտահանվել է էլեկտրաէներգիա",
     "4. Ծախսվել է էլետրակայանների սեփական արտադրական կարիքների համար",
     "5. Կորուստներն ընդհանուր օգտագործման ցանցերում",
     "6. Օգտակար սպառում, ընդամենը",
     "6.1. արդյունաբերությունում",
     "6.2. շինարարությունում",
     "6.3. գյուղատնտեսությունում",
     "6.4. տրանսպորտում",
     "6.4.1. երկաթգծում",
     "6.4.2. էլեկտրատրանսպորտում (առանց մետրոպոլիտենի)",
     "6.4.3. մետրոպոլիտենում",
     "6.4.4. օդանավակայաններում",
     "6.4.5. այլ տրանսպորտային կազմակերպություններում",
     "6.5. բնակչության կողմից",
     "6.6. այլ  ճյուղերում"
    ]
   },
