    "valueTexts": [
     "Վարակային և մակաբուծային",
     "Ներզատական (էնդոկրին) համակարգի հիվանդություններ, սնուցման և նյութափոխանակության խանգարումներ",
     "Արյունաստեղծ օրգանների առանձին խանգարումներ` արյան իմունային մեխանիզմների ներգրավմամբ",
     "Նյարդային համակարգի",
     "Աչքի և դրա օժանդակ ապարատի",
     "Ականջի և պտկաձև ելունի",
     "Շնչառական օրգանների",
     "Մարսողության օրգանների",
     "Միզասեռական համակարգի",
     "Բնածին արատներ",
     "Պերինատալ շրջանում առաջացող առանձին վիճակներ",
     "Վնասվածքներ և թունավորումներ",
     "Այլ",
     "Ընդամենը"
    ]
