  "title": "Տարեվերջին դիսպանսերային հսկողության տակ գտնվող հիվանդների թվաքանակն, 2011-2024թթ.",
  "variables": [
   {
    "code": "indicators",
    "text": "ըստ ցուցանիշների",
    "values": [
