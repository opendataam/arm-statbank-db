     "1"
    ],
    "valueTexts": [
     "Մեծահասակներ և դեռահասներ",
     "0-14 տարեկան երեխաներ"
    ]
   },
   {
    "code": "groups of diseases",
    "text": "ըստ առանձին հիվանդությունների",
    "values": [
     "0",
     "1",
