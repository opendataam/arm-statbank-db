    "valueTexts": [
     "Սպառողական գների ինդեքս, ընդամենը",
     "պարենային ապրանքներ",
     "ոգելից խմիչք, ծխախոտ",
     "հագուստ և կոշիկ",
     "բնակվարձ, վառելիք, էլեկտրաէներգիա",
     "տնային գործածության ապրանքներ",
     "բուժսպասարկում և դեղորայք",
     "տրանսպորտ և կապ",
     "մշակույթի ապրանքներ և ծառայություններ",
     "այլ ապրանքներ և ծառայություններ",
     "  սպառման ապրանքներ, ընդամենը",
     "  պարենային ապրանքներ  (ներառյալ ոգելից խմիչք և ծխախոտ)",
     "հացամթերք",
     "մսամթերք",
     "ձկնամթերք",
     "կաթնամթերք",
     "ձու",
     "կենդանական և բուսական յուղ",
     "միրգ",
     "բանջարեղեն և կարտոֆիլ",
     "շաքարավազ",
     "սուրճ, թեյ, կակաո",
     "հրուշակեղեն",
     "այլ մթերք",
     "ոչ ոգելից խմիչք",
