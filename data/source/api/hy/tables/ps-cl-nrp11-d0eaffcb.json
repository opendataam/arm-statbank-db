    "valueTexts": [
     "Մասսայական-քաղաքական",
     "Գիտական",
     "Գիտահանրամատչելի",
     "Պաշտոնական-կառավարական",
     "Դասագրքեր հանրակրթական դպրոցի համար",
     "Դասագրքեր միջին մասնագիտական կրթության համար",
     "Դասագրքեր բուհերի համար",
     "Ոսումնական և մեթոդական գրականություն հանրակրթական դպրոցի համար",
     "Ձեռնարկներ գործնական և լաբորատոր աշխատանքների համար",
     "Գործնական և լաբորատոր աշխատանքների ձեռնարկներ բուհերի համար",
     "Ուսումնական և մեթոդական գրականություն ուսումնառության տարբեր ձևերի համար",
     "Հանրագիտարաններ",
     "Բառարաններ",
     "Տեղեկատուներ",
     "Մատենագիտական ցանկեր",
     "Կրոնական գրականություն",
     "Գեղարվեստական գրականություն",
     "Մանկական գրականություն",
     "Ընթերցողների լայն շրջանի համար",
     "Ընդամենը"
    ]
