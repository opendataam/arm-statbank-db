    "valueTexts": [
     "Ածուխ, խոր. Մ",
     "Աղ /աղային լուծույթից/, տ",
     "Անդեզիտ, խոր. մ",
     "Անդեզիտաբազալտ, խոր. մ",
     "Անդեզիտադացիտ, խոր. Մ",
     "Անդեզիտատրախիտ, խոր. մ",
     "Ավազ, խոր. մ",
     "Ավազակոպճային խառնուրդ, խոր. մ",
     "Ավազային կրաքար, խոր. մ",
     "Բազալտ, խոր. մ",
     "Բազալտի խիճ, խոր. մ",
     "Բալաստային հումք, խոր. մ",
     "Բենտոնիտային կավ, տ",
     "Բյուրեղային կրաքար, տ",
     "Գաբրո, խոր. մ",
     "Գաբրոդիորիտ, խոր. մ",
     "Գաբրոսիենիտ, խոր. մ",
     "Գիպսատար կավ, խոր. մ",
     "Գիպսաքար, գիպսատար ապար, խոր. մ",
     "Գրանիտ /տոնալիտ/, խոր. մ",
     "Գրանոդիորիտ, խոր. մ",
     "Դացիտային տուֆ, խոր. մ",
     "Դիաբազային պորֆիրիտ, խոր. մ",
     "Դիատոմիտ, խոր. մ",
     "Դոլերիտ, խոր. մ",
     "Դոլերիտային բազալտ, խոր. մ",
     "Լիտոիդային պեմզա, խոր. մ",
     "Խիճ, լիպարիտային խիճ, խոր. մ",
     "Կավ, խոր. մ",
     "Քվարցիտ, խոր. մ",
     "Կրաքար, մարմարացված կրաքար, մերգելային կրաքար, խոր. մ",
     "Հանքաքար բազմամետաղային, հազ. տ",
     "Հանքաքար պղնձամոլիբդենային, հազ. տ",
     "Հրաբխային խարամ, խոր. մ",
     "Հրաբխային խարամի ավազ, խոր. մ",
     "Մարմար, խոր. մ",
     "Մետաղներ, տ",
     "Մոնցոնիտ, խոր. մ",
     "Պեմզա, խոր. մ",
     "Պեռլիտ, պեռլիտային ավազ, խոր. մ",
     "Տորֆ, տ",
     "Տուֆ, պեմզային տուֆ, խոր. մ",
     "Տուֆավազաքար, խոր. մ",
     "Տրակտոլիտ, խոր. մ",
     "Տրավերտին, խոր. մ",
     "Ցեոլիտ, խոր. մ",
     "Փիրուզ, կգ",
     "Քարաղ, տ",
     "Ֆելզիտ, խոր. մ",
     "Ֆելզիտային տուֆ, խոր. մ"
    ]
