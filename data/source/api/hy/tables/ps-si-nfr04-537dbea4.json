     "18",
     "19",
     "20"
    ],
    "valueTexts": [
     "Հաշմանդամության 1-ին խումբ",
     "Հաշմանդամության 2-րդ խումբ",
     "Հաշմանդամության 3-րդ խումբ",
     "Ֆունկցիոնալության խորը աստիճանի սահմանափակում ունեցող անձ",
     "Ֆունկցիոնալության ծանր աստիճանի սահմանափակում ունեցող անձ",
     "Ֆունկցիոնալության միջին աստիճանի սահմանափակում ունեցող անձ",
     "Հաշմանդամություն ունեցող երեխա",
     "Երեխա՝ մինչև 5 տարեկանը լրանալը",
     "Երեխա՝ 5 տարեկանից մինչև 18 տարեկանը լրանալը",
     "Միակողմանի ծնողազուրկ երեխա",
     "Առանց ծնողական խնամքի մնացած երեխա",
     "Միայնակ մոր երեխա",
     "Ամուսնալուծված անձի երեխա",
     "Ուսանող՝ մինչև 23 տարեկան",
     "Սովորող՝ 18 տարեկանից մինչև հանրակրթական ուսումնական հաստատությունն ավարտելու տարվա հունիս ամիսը ներառյալ",
     "Հղի կին (12 շաբաթական և ավելի ժամկետով)",
     "Գործազուրկ",
     "Աշխատանքի շուկայում անմրցունակ անձ",
     "Կենսաթոշակառու",
     "Միայնակ չաշխատող կենսաթոշակառու",
     "Տարեց կենսաթոշակառու (75 տարեկան և բարձր)"
    ]
   },
