    ],
    "valueTexts": [
     "Ընտանեկան նպաստ ստացող ընտանիքների քանակը",
     "Սոցիալական նպաստ ստացող ընտանիքների քանակը",
     "Եռամսյակային հրատապ օգնություն ստացող ընտանիքների քանակը"
    ]
   },
   {
    "code": "social groups",
    "text": "ըստ սոցիալական խմբերի",
    "values": [
     "0",
