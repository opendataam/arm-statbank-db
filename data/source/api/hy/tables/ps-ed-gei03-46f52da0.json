    "valueTexts": [
     "Շենքերի վիճակը, բավարար",
     "Հիմնավերանորոգման կարիք ունեցող շենքերի քանակը",
     "Ընթացիկ նորոգման կարիք ունեցող շենքերի քանակը",
     "Ջրամատակարարումը, առկա է",
     "Ջրամատակարարումը, բացակայում է",
     "Տաք ջրամատակարարումը, առկա է",
     "Տաք ջրամատակարարումը, բացակայում է",
     "Կոյուղացումը, առկա է",
     "Կոյուղացումը, բացակայում է",
     "Գազամատակարարումը, առկա է",
     "Գազամատակարարումը, բացակայում է",
     "Ջեռուցումը, կենտրոնացված կամ անհատական",
     "Ջեռուցումը, էլեկտրաջեռուցիչ կամ վառարան",
     "Ջեռուցումը, բացակայում է",
     "Ֆիքսված հեռախոսակապը, առկա է",
     "Ֆիքսված հեռախոսակապը, բացակայում է",
     "Համակարգիչների քանակը",
     "Ինտերնետային ցանցին միացված դպրոցների քանակը"
