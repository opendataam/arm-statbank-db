    "valueTexts": [
     "Հայաստանի Հանրապետություն",
     "ք. Երևան",
     "Արագածոտնի մարզ",
     "Արարատի մարզ",
     "Արմավիրի մարզ",
     "Գեղարքունիքի մարզ",
     "Լոռու մարզ",
     "Կոտայքի մարզ",
     "Շիրակի մարզ",
     "Սյունիքի մարզ",
     "Վայոց Ձորի մարզ",
     "Տավուշի մարզ"
    ]
   },
   {
    "code": "indicators",
    "text": "ըստ ցուցանիշների",
    "values": [
     "0",
