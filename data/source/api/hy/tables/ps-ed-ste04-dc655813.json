    ],
    "valueTexts": [
     "Ավարտված և պատվիրատուի կողմից ընդունված աշխատանքների փաստացի ծավալը",
     "Տարեսկզբից կատարված աշխատանքների ծավալը",
     "     այդ թվում՝ գիտատեխնիկական",
     "            այդ թվում՝ գիտահետազոտական",
     "                             դրանից` հիմնարար",
     "            նախագծակոնստրուկտորական և տեխնոլոգիական",
     "            փորձնական նմուշների (արտադրանքի)  խմբերի պատրաստում",
     "            շինարարության համար նախագծային աշխատանքներ",
     "            գիտատեխնիկական ծառայություններ",
     "            այլ աշխատանքներ (ծառայություններ)"
    ]
   },
