  "title": "Ֆունկցիոնալության սահմանափակում ունեցող անձանց թվաքանակն",
  "variables": [
   {
    "code": "indicators",
    "text": "ըստ ցուցանիշների",
    "values": [
     "0",
     "1",
     "2"
    ],
    "valueTexts": [
     "Ֆունկցիոնալության սահմանափակում ունեցող անձանց թվաքանակը, ընդամենը",
     "Ֆունկցիոնալության սահմանափակում ունեցող անձանց թվաքանակը, արական",
     "Ֆունկցիոնալության սահմանափակում ունեցող անձանց թվաքանակը, իգական"
    ]
   },
   {
    "code": "cause of disability",
    "text": "ըստ hաշմանդամության պատճառական կապի",
    "values": [
     "0",
     "1",
     "2",
     "3",
     "4",
     "5",
     "6",
     "7",
     "8"
    ],
    "valueTexts": [
     "Մանկուց (մինչև 18 տարին լրանալը) ձեռք բերած հիվանդությունը",
     "Ընդհանուր հիվանդությունը",
     "Աշխատանքային վնասվածքը",
     "Մասնագիտական հիվանդությունը",
     "Բնական, տեխնածին և այլ աղետները, ինչպես նաև դրանց վերացման աշխատանքների ժամանակ ձեռք բերած հիվանդությունը կամ ստացած վնասվածքը",
     "Զինվորական ծառայության ընթացքում ձեռք բերած հիվանդությունը կամ ստացած վնասվածքը",
     "Չեռնոբիլի ատոմային էլեկտրակայանի վթարի և այլ ճառագայթային աղետների հետևանքների վերացման աշխատանքների ժամանակ ձեռք բերած հիվանդությունը կամ ստացած վնասվածքը",
     "Այլ դեպքեր",
     "Ընդամենը"
    ]
   },
